# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dems

# JWT
JWT_SECRET=dems-super-secret-jwt-key-2026-smart-india-hackathon
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=dems-refresh-secret-key-2026

# Email Configuration (for OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=DEMS System <your-email@gmail.com>

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# 2FA Configuration
TOTP_WINDOW=2
TOTP_STEP=30
TOTP_ISSUER=DEMS-System

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads